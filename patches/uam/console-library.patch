diff --git a/source/dkp_uam.cpp b/source/dkp_uam.cpp
new file mode 100644
index 0000000..04eba84
--- /dev/null
+++ b/source/dkp_uam.cpp
@@ -0,0 +1,46 @@
+// wgpu-deko-proof addition: compiles GLSL to DKSH in memory, for the console build (static library).
+#include "compiler_iface.h"
+
+#include <pthread.h>
+
+// Mesa's GLSL frontend keeps global state, so compiles are serialized.
+static pthread_mutex_t s_lock = PTHREAD_MUTEX_INITIALIZER;
+
+extern "C" {
+
+// stage is a pipeline_stage value. Returns a malloc'd DKSH image (free with dkp_uam_free), or NULL
+// when the GLSL does not compile; the frontend reports why on stderr.
+uint8_t* dkp_uam_compile(int stage, const char* glsl, size_t* size)
+{
+	if (stage < pipeline_stage_vertex || stage > pipeline_stage_compute || !glsl || !size)
+		return nullptr;
+	char* bytes = nullptr;
+	size_t length = 0;
+	pthread_mutex_lock(&s_lock);
+	{
+		DekoCompiler compiler(static_cast<pipeline_stage>(stage));
+		if (compiler.CompileGlsl(glsl))
+		{
+			FILE* f = open_memstream(&bytes, &length);
+			if (f)
+			{
+				compiler.WriteDksh(f);
+				if (fclose(f) != 0)
+				{
+					free(bytes);
+					bytes = nullptr;
+				}
+			}
+		}
+	}
+	pthread_mutex_unlock(&s_lock);
+	*size = bytes ? length : 0;
+	return reinterpret_cast<uint8_t*>(bytes);
+}
+
+void dkp_uam_free(void* dksh)
+{
+	free(dksh);
+}
+
+}
