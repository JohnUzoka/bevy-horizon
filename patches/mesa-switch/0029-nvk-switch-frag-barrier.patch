+#ifdef HAVE_SWITCH_PLATFORM
+/* NVK_SWITCH_FRAG_BARRIER: a barrier from fragment work to fragment work
+ * waits only for earlier pixel shaders (PIXEL_SHADER_BARRIER, deko3d's
+ * DkBarrier_Fragments) instead of the whole engine (WAIT_FOR_IDLE). 0, the
+ * default, is off; 1 takes color attachment and sampled reads and writes; 2
+ * depth/stencil attachments too. From masseffect-nx's NVK patch.
+ */
+DEBUG_GET_ONCE_NUM_OPTION(nvk_switch_frag_barrier, "NVK_SWITCH_FRAG_BARRIER", 0)
+static uint32_t nvk_switch_frag_barrier_count;
+
+static const VkPipelineStageFlags2 nvk_frag_stages =
+   VK_PIPELINE_STAGE_2_FRAGMENT_SHADER_BIT |
+   VK_PIPELINE_STAGE_2_EARLY_FRAGMENT_TESTS_BIT |
+   VK_PIPELINE_STAGE_2_LATE_FRAGMENT_TESTS_BIT |
+   VK_PIPELINE_STAGE_2_COLOR_ATTACHMENT_OUTPUT_BIT;
+
+static bool
+nvk_barrier_is_frag_to_frag(VkPipelineStageFlags2 src_stages,
+                            VkAccessFlags2 src_access,
+                            VkPipelineStageFlags2 dst_stages,
+                            int64_t mode)
+{
+   src_stages = vk_expand_src_stage_flags2(src_stages);
+   dst_stages = vk_expand_dst_stage_flags2(dst_stages);
+   src_access = vk_filter_src_access_flags2(src_stages, src_access);
+   if (!src_stages || (src_stages & ~nvk_frag_stages))
+      return false;
+   if (!dst_stages || (dst_stages & ~nvk_frag_stages))
+      return false;
+   VkAccessFlags2 allowed = VK_ACCESS_2_COLOR_ATTACHMENT_WRITE_BIT |
+                            VK_ACCESS_2_COLOR_ATTACHMENT_READ_BIT |
+                            VK_ACCESS_2_SHADER_SAMPLED_READ_BIT |
+                            VK_ACCESS_2_INPUT_ATTACHMENT_READ_BIT;
+   if (mode >= 2)
+      allowed |= VK_ACCESS_2_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT |
+                 VK_ACCESS_2_DEPTH_STENCIL_ATTACHMENT_READ_BIT;
+   else if (src_stages & (VK_PIPELINE_STAGE_2_EARLY_FRAGMENT_TESTS_BIT |
+                          VK_PIPELINE_STAGE_2_LATE_FRAGMENT_TESTS_BIT))
+      return false;
+   return !(src_access & ~allowed);
+}
+
+static bool
+nvk_dep_is_frag_to_frag(const VkDependencyInfo *dep, int64_t mode)
+{
+   if (dep->dependencyFlags & VK_DEPENDENCY_ASYMMETRIC_EVENT_BIT_KHR)
+      return false;
+   if (dep->bufferMemoryBarrierCount)
+      return false;
+   if (!dep->memoryBarrierCount && !dep->imageMemoryBarrierCount)
+      return false;
+   for (uint32_t i = 0; i < dep->memoryBarrierCount; i++) {
+      const VkMemoryBarrier2 *bar = &dep->pMemoryBarriers[i];
+      if (!nvk_barrier_is_frag_to_frag(bar->srcStageMask, bar->srcAccessMask,
+                                       bar->dstStageMask, mode))
+         return false;
+   }
+   for (uint32_t i = 0; i < dep->imageMemoryBarrierCount; i++) {
+      const VkImageMemoryBarrier2 *bar = &dep->pImageMemoryBarriers[i];
+      if (bar->srcQueueFamilyIndex != bar->dstQueueFamilyIndex)
+         return false;
+      /* A layout change from undefined may initialize ZCULL through the copy
+       * engine, which the pixel shader barrier doesn't wait for.
+       */
+      if (bar->oldLayout == VK_IMAGE_LAYOUT_UNDEFINED ||
+          bar->oldLayout == VK_IMAGE_LAYOUT_PREINITIALIZED)
+         return false;
+      if (!nvk_barrier_is_frag_to_frag(bar->srcStageMask, bar->srcAccessMask,
+                                       bar->dstStageMask, mode))
+         return false;
+   }
+   return true;
+}
+#endif
+
+/* Whether this dependency's wait can be a pixel shader barrier
+ * (NVK_SWITCH_FRAG_BARRIER).
+ */
+static bool
+nvk_cmd_frag_barrier_only(struct nvk_cmd_buffer *cmd,
+                          const VkDependencyInfo *dep,
+                          enum nvk_barrier barriers)
+{
+#ifdef HAVE_SWITCH_PLATFORM
+   const int64_t mode = debug_get_option_nvk_switch_frag_barrier();
+   const struct nvk_physical_device *pdev =
+      nvk_device_physical(nvk_cmd_buffer_device(cmd));
+   if (mode <= 0 || (barriers & ~NVK_BARRIER_WFI) ||
+       pdev->info.cls_eng3d < MAXWELL_B ||
+       nvk_cmd_buffer_last_subchannel(cmd) != SUBC_NV9097 ||
+       !nvk_dep_is_frag_to_frag(dep, mode))
+      return false;
+   const uint32_t n = p_atomic_inc_return(&nvk_switch_frag_barrier_count);
+   if (n == 1 || n == 1000 || n == 100000)
+      fprintf(stderr, "[NVK] PIXEL_SHADER_BARRIER instead of WAIT_FOR_IDLE "
+              "(NVK_SWITCH_FRAG_BARRIER=%d): %u\n", (int)mode, n);
+   return true;
+#else
+   return false;
+#endif
+}
+
 void
 nvk_cmd_flush_wait_dep(struct nvk_cmd_buffer *cmd,
                        const VkDependencyInfo *dep,
@@ -944,6 +1048,14 @@ nvk_cmd_flush_wait_dep(struct nvk_cmd_buffer *cmd,
             .flush_data = FLUSH_DATA_TRUE,
          });
       }
