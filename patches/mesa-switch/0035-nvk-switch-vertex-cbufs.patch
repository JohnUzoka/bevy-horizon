From 5c7a75edf1e6fe697ab232e7471e66e9138f7807 Mon Sep 17 00:00:00 2001
From: John Uzoka <johnuzoka19@gmail.com>
Date: Mon, 2 Nov 2026 17:56:33 -0500
Subject: [PATCH] bevy-horizon: Switch vertex shaders take their uniform
 buffers as cbufs

Before Turing, NVK reads a uniform buffer from a non-push descriptor set with global loads rather
than binding it as a cbuf, since binding one needs a non-prefetchable pushbuffer fetch of its
descriptor. The Switch already made an exception for fragment shaders (Horizon skips the setup
for fragment helper lanes' global loads). Vertex shaders pay for the rule on every vertex: horizon
(Minecraft in Rust)'s terrain vertex shader loaded its view matrix and light count with five
ld.global.a64.constant before its position (NAK_DEBUG=final: 183 instructions, 5,038 static
cycles), while its fragment shaders read the same buffer from c[1]. Its triangles are the Switch
GPU's main cost (~11 GPU clocks each against ~1 a clock of setup).

Vertex shaders now take the exception too; a bind costs one descriptor fetch, a frame binds a
handful. NVK_DEBUG=no_vertex_cbuf keeps them on global loads, and keys the shader cache (bit 15 of
the compiler flags) with the compiler ABI revision bumped to 12, so a card's cached shaders are
rebuilt either way.
---
 src/nouveau/vulkan/nvk_debug.h                |  5 +++++
 src/nouveau/vulkan/nvk_instance.c             |  1 +
 .../vulkan/nvk_nir_lower_descriptors.c        | 21 +++++++++++++------
 src/nouveau/vulkan/nvk_shader.c               |  4 +++-
 4 files changed, 24 insertions(+), 7 deletions(-)

diff --git a/src/nouveau/vulkan/nvk_debug.h b/src/nouveau/vulkan/nvk_debug.h
index 169b6d9..812efbf 100644
--- a/src/nouveau/vulkan/nvk_debug.h
+++ b/src/nouveau/vulkan/nvk_debug.h
@@ -45,6 +45,11 @@ enum nvk_debug {
 
    /* Disable image compression */
    NVK_DEBUG_NO_COMPRESSION = 1ull << 9,
+
+   /* Switch: vertex shaders read uniform buffers from global memory instead
+    * of cbufs, as before they took cbufs like fragment shaders
+    */
+   NVK_DEBUG_NO_VERTEX_CBUF = 1ull << 10,
 };
 
 enum nvk_experimental {
diff --git a/src/nouveau/vulkan/nvk_instance.c b/src/nouveau/vulkan/nvk_instance.c
index e125847..7329d7b 100644
--- a/src/nouveau/vulkan/nvk_instance.c
+++ b/src/nouveau/vulkan/nvk_instance.c
@@ -133,6 +133,7 @@ nvk_init_debug_flags(struct nvk_instance *instance)
       { "gart", NVK_DEBUG_FORCE_GART },
       { "coherent", NVK_DEBUG_FORCE_COHERENT },
       { "no_compression", NVK_DEBUG_NO_COMPRESSION },
+      { "no_vertex_cbuf", NVK_DEBUG_NO_VERTEX_CBUF },
       { NULL, 0 },
    };
 
diff --git a/src/nouveau/vulkan/nvk_nir_lower_descriptors.c b/src/nouveau/vulkan/nvk_nir_lower_descriptors.c
index 9feed84..2c4a496 100644
--- a/src/nouveau/vulkan/nvk_nir_lower_descriptors.c
+++ b/src/nouveau/vulkan/nvk_nir_lower_descriptors.c
@@ -61,6 +61,7 @@ struct lower_descriptors_ctx {
    bool clamp_desc_array_bounds;
    bool indirect_bind;
    bool has_task_shader;
+   bool vertex_cbufs;
    nir_address_format ubo_addr_format;
    nir_address_format ssbo_addr_format;
 
@@ -461,11 +462,17 @@ build_cbuf_map(nir_shader *nir, struct lower_descriptors_ctx *ctx)
    }
 
 #ifdef HAVE_SWITCH_PLATFORM
-   /* Horizon skips the setup for fragment helper global loads. */
-   const bool fragment_cbufs = ctx->dev_info->sm == 53 &&
-                              nir->info.stage == MESA_SHADER_FRAGMENT;
+   /* Horizon skips the setup for fragment helper global loads. Vertex
+    * shaders take their uniform buffers as cbufs too: their loads sit before
+    * every vertex's position (a terrain vertex waited on five global loads
+    * of its view matrix), against one descriptor fetch per bind.
+    * NVK_DEBUG=no_vertex_cbuf keeps them on global loads.
+    */
+   const bool switch_cbufs = ctx->dev_info->sm == 53 &&
+      (nir->info.stage == MESA_SHADER_FRAGMENT ||
+       (nir->info.stage == MESA_SHADER_VERTEX && ctx->vertex_cbufs));
 #else
-   const bool fragment_cbufs = false;
+   const bool switch_cbufs = false;
 #endif
 
    for (uint32_t i = 0; i < num_cbufs; i++) {
@@ -479,12 +486,13 @@ build_cbuf_map(nir_shader *nir, struct lower_descriptors_ctx *ctx)
          continue;
 
       /* Non-push descriptors need a non-prefetchable pushbuf fetch before
-       * Turing. Avoid it unless fragment helper lanes require cbuf loads.
+       * Turing. Avoid it unless the Switch's fragment helper lanes require
+       * cbuf loads or a vertex shader's latency does.
        */
       if (ctx->dev_info->cls_eng3d < TURING_A &&
           cbufs[i].key.type == NVK_CBUF_TYPE_UBO_DESC &&
           (debug_get_bool_option("NVK_SWITCH_NO_UBO_CBUF", false) ||
-           (!fragment_cbufs && !cbuf_set_is_push(ctx, cbufs[i].key.desc_set))))
+           (!switch_cbufs && !cbuf_set_is_push(ctx, cbufs[i].key.desc_set))))
          continue;
 
       ctx->cbuf_map->cbufs[ctx->cbuf_map->cbuf_count++] = cbufs[i].key;
@@ -1582,6 +1590,7 @@ nvk_nir_lower_descriptors(nir_shader *nir,
       .indirect_bind =
          shader_flags & VK_SHADER_CREATE_INDIRECT_BINDABLE_BIT_EXT,
       .has_task_shader = (shader_flags & VK_SHADER_CREATE_NO_TASK_SHADER_BIT_EXT) == 0,
+      .vertex_cbufs = !(pdev->debug_flags & NVK_DEBUG_NO_VERTEX_CBUF),
       .ssbo_addr_format = nvk_ssbo_addr_format(pdev, rs),
       .ubo_addr_format = nvk_ubo_addr_format(pdev, rs),
    };
diff --git a/src/nouveau/vulkan/nvk_shader.c b/src/nouveau/vulkan/nvk_shader.c
index bdcd481..15dba6c 100644
--- a/src/nouveau/vulkan/nvk_shader.c
+++ b/src/nouveau/vulkan/nvk_shader.c
@@ -75,6 +75,7 @@ nvk_physical_device_compiler_flags(const struct nvk_physical_device *pdev)
 {
    const struct nvk_instance *instance = nvk_physical_device_instance(pdev);
    bool no_cbufs = pdev->debug_flags & NVK_DEBUG_NO_CBUF;
+   bool no_vertex_cbufs = pdev->debug_flags & NVK_DEBUG_NO_VERTEX_CBUF;
    bool use_edb_buffer_views = nvk_use_edb_buffer_views(pdev);
    uint64_t nak_flags = nak_debug_flags(pdev->nak);
    /* NAK_GPR_LIMIT changes the code, so it keys the shader cache too. */
@@ -86,7 +87,8 @@ nvk_physical_device_compiler_flags(const struct nvk_physical_device *pdev)
    return (no_cbufs ? 1 << 12 : 0)
       | (use_edb_buffer_views ? 1 << 13 : 0)
       | (instance->drirc.misc.ssbo_align_4b ? 1 << 14 : 0)
-      | (UINT64_C(11) << 16) /* Compiler ABI revision. */
+      | (no_vertex_cbufs ? 1 << 15 : 0)
+      | (UINT64_C(12) << 16) /* Compiler ABI revision. */
       | (nak_gpr_limit << 24)
       | (nak_flags << 32);
 }
-- 
